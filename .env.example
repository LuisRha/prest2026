# ============================================
# PLANTILLA de variables de entorno.
# Copia este archivo como ".env" y rellena con tus valores reales.
# NO pongas claves reales en este archivo (este sí se sube a GitHub).
# ============================================

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_clave_service_role_aqui

# --- Login del administrador ---
ADMIN_USUARIO=tu_usuario
ADMIN_PASSWORD=tu_contraseña_segura

# --- Servidor ---
PORT=3000
SESSION_SECRET=pon-aqui-una-frase-larga-unica-y-secreta

# --- País por defecto para WhatsApp (código sin el +) ---
# Ecuador = 593, Colombia = 57, México = 52, Perú = 51
CODIGO_PAIS=593

# --- Nombre que aparece en los mensajes de WhatsApp (tu firma) ---
NOMBRE_NEGOCIO=El Coyote Malo
