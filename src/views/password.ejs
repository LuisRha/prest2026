<%- include('partials/header', { titulo: 'Cambiar contraseña' }) %>

<div class="cabecera-seccion">
  <h1>Cambiar contraseña</h1>
  <a href="<%= usuario && usuario.rol === 'admin' ? '/' : '/cliente' %>" class="btn">← Volver</a>
</div>

<% if (ok) { %>
  <div class="alerta" style="background:#dcfce7;color:#16a34a;border:1px solid #bbf7d0;">
    ✅ Tu contraseña se cambió correctamente.
  </div>
<% } %>

<% if (error) { %>
  <div class="alerta alerta-error"><%= error %></div>
<% } %>

<form action="/password" method="POST" class="form form-ancho">
  <label>Contraseña actual *</label>
  <input type="password" name="actual" required />

  <label>Nueva contraseña *</label>
  <input type="password" name="nueva" required />

  <label>Repite la nueva contraseña *</label>
  <input type="password" name="nueva2" required />

  <small class="ayuda">Mínimo 6 caracteres. Usa una que solo tú sepas.</small>

  <button type="submit" class="btn btn-primario">Guardar nueva contraseña</button>
</form>

<%- include('partials/footer') %>
